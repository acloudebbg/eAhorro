# Server-side only — leída por netlify/functions/validate-document.mts vía process.env.
# NUNCA la prefijes con VITE_: eso la expondría en el bundle del navegador via import.meta.env.
# Consigue una key en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Trazas de las llamadas a Claude en https://www.braintrust.dev (proyecto dd851973-57cc-445a-a8df-6438b78a1a62).
# Opcional: si no se define, validate-document.mts usa el cliente Anthropic sin instrumentar.
# Consigue una key en Braintrust > Settings > API Keys (org en la región EU).
BRAINTRUST_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Esta org usa la región EU, no el endpoint por defecto de Braintrust.
BRAINTRUST_API_URL=https://api-eu.braintrust.dev
